# Backend Environment Variables
# Copy this file to .env and modify values for your environment

# Application Environment
NODE_ENV=development
PORT=4000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notifypro
DB_USER=root
DB_PASSWORD=root

# Security
JWT_SECRET=your-super-secret-jwt-key-here
CORS_ORIGIN=*

# CDN Base URL - Where your SDK and static files are hosted
# This is used for generating service worker import scripts
CDN_BASE=http://localhost:4000

# =============================================================================
# CDN_BASE USAGE IN BACKEND
# =============================================================================
# 
# The backend uses CDN_BASE for:
# 
# 1. SERVICE WORKER GENERATION
#    - /download/pn-sw.js endpoint generates service worker files
#    - Service workers need to import scripts from CDN
#    - Uses CDN_BASE to generate correct importScripts() URLs
#
# 2. SDK FILE REFERENCES  
#    - API responses may include SDK download URLs
#    - Points to the correct CDN domain for static files
#
# 3. DOCUMENTATION EXAMPLES
#    - Generated code snippets use CDN_BASE for SDK URLs
#    - Ensures examples work across environments
#
# =============================================================================

# Environment-specific configurations:

# Development
# CDN_BASE=http://localhost:4000

# Staging
# CDN_BASE=https://cdn-staging.pushads123.com

# Production with same domain
# CDN_BASE=https://pushads123.com

# Production with separate CDN
# CDN_BASE=https://cdn.pushads123.com

# Production with CloudFlare
# CDN_BASE=https://sdk.pushads123.com

# Production with AWS CloudFront
# CDN_BASE=https://d123456789.cloudfront.net

# VAPID Configuration (Optional - auto-generated if not provided)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:your-email@domain.com