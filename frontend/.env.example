# Environment Variables Configuration
# Copy this file to .env.local and modify values for your environment

# API Base URL - Your backend API server
VITE_API_BASE=https://pushads123.com

# CDN Base URL - Your CDN/static files server
# This is where your SDK files, service workers, and static assets are hosted
# Can be same as API base or a separate CDN domain for better performance
VITE_CDN_BASE=https://pushads123.com

# Application Environment
VITE_NODE_ENV=development

# Logging Configuration
VITE_ENABLE_LOGGING=true

# Analytics Configuration  
VITE_ENABLE_ANALYTICS=false

# Request Timeout (milliseconds)
VITE_REQUEST_TIMEOUT=10000

# =============================================================================
# WHY SEPARATE CDN_BASE FROM API_BASE?
# =============================================================================
# 
# 1. PERFORMANCE OPTIMIZATION
#    - CDN domains are optimized for static file delivery
#    - Geographic distribution reduces latency
#    - Better caching strategies for JavaScript SDK files
#
# 2. SCALABILITY
#    - API server handles dynamic requests
#    - CDN handles static assets (SDK, service workers)
#    - Reduces load on main API server
#
# 3. RELIABILITY
#    - If API server is down, SDK files still load from CDN
#    - Better availability for critical client-side files
#
# 4. SECURITY
#    - Different security policies for API vs static files
#    - CDN can have relaxed CORS for public SDK files
#
# 5. DEVELOPMENT FLEXIBILITY
#    - Can point to localhost during development
#    - Easy switching between development/staging/production CDNs
#
# =============================================================================

# Example configurations for different environments:

# Development (Local Development)
# VITE_API_BASE=http://localhost:4000
# VITE_CDN_BASE=http://localhost:4000

# Staging Environment
# VITE_API_BASE=https://api-staging.pushads123.com
# VITE_CDN_BASE=https://cdn-staging.pushads123.com

# Production with separate CDN
# VITE_API_BASE=https://api.pushads123.com
# VITE_CDN_BASE=https://cdn.pushads123.com

# Production with CloudFlare CDN
# VITE_API_BASE=https://pushads123.com
# VITE_CDN_BASE=https://sdk.pushads123.com

# Production with AWS CloudFront
# VITE_API_BASE=https://pushads123.com  
# VITE_CDN_BASE=https://d123456789.cloudfront.net